# WEBPRISM 環境變數範例
# 複製此檔案為 .env 並填入實際的機密資訊
#
# 📝 配置說明：
# - 非機密配置 → deployments/config.yaml (可提交到 Git)
# - 機密資訊 → .env (不應提交到 Git)
# - 環境變數會覆蓋 config.yaml 中的設定

# ============================================
# 必要的機密資訊
# ============================================

# 資料庫密碼 (REQUIRED)
WEBPRISM_DATABASE_PASSWORD=your-database-password-here

# 加密金鑰 (REQUIRED - 必須正好 32 bytes)
# 生成方式：openssl rand -base64 32 | head -c 32
# ⚠️  請務必在生產環境中使用安全的隨機金鑰！
WEBPRISM_SECURITY_ENCRYPTION_KEY=REPLACE-WITH-32-BYTE-KEY-12345

# ============================================
# 可選的覆蓋設定
# ============================================
# 如需覆蓋 config.yaml 中的設定，可在此處取消註解並修改

# 資料庫連線（如果與 config.yaml 不同）
# WEBPRISM_DATABASE_HOST=localhost
# WEBPRISM_DATABASE_PORT=5432
# WEBPRISM_DATABASE_USER=webprism
# WEBPRISM_DATABASE_DATABASE=webprism
# WEBPRISM_DATABASE_SSL_MODE=disable

# 伺服器端口
# WEBPRISM_SERVER_HTTP_PORT=8080
# WEBPRISM_SERVER_GRPC_PORT=9090

# 日誌設定
# WEBPRISM_LOGGING_LEVEL=debug
# WEBPRISM_LOGGING_FORMAT=console
